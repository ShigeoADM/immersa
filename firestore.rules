// Reglas de seguridad de Firestore para Immersa.
// Se publican en la consola de Firebase → Firestore Database → Reglas.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isUser(uid) { return signedIn() && request.auth.uid == uid; }

    // ── Roles y permisos (misma lógica que constants/permissions.ts) ──────────
    //   users/{uid}.role: 'owner' (dueño, todos los permisos) | 'admin'
    //   users/{uid}.permissions: lista de permisos de un admin
    //     'deleteStories' | 'announcements' | 'manageAdmins'
    // El dueño solo se asigna desde la consola de Firebase.
    function me() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    // Rol propio; '' si no tiene (o si la cuenta no tiene documento de usuario)
    function myRole() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? me().get('role', '')
        : '';
    }
    function isOwner() { return signedIn() && myRole() == 'owner'; }
    function can(permission) {
      return signedIn() && (
        myRole() == 'owner'
        || (myRole() == 'admin' && permission in me().get('permissions', []))
      );
    }

    // Cuenta suspendida por moderación: puede leer, pero no publicar ni comentar
    function isSuspended() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && me().get('suspended', false) == true;
    }

    function ownsStory(storyId) {
      return signedIn()
        && get(/databases/$(database)/documents/stories/$(storyId)).data.uid == request.auth.uid;
    }
    function storyPublished(storyId) {
      return get(/databases/$(database)/documents/stories/$(storyId)).data.published == true;
    }
    // Lo que puede leer cualquiera, también sin cuenta (versión web): el contenido de
    // las historias publicadas. Las +18 exigen haber iniciado sesión; a partir de ahí
    // es la app la que comprueba la edad, igual que hasta ahora.
    function storyAdult(storyId) {
      return get(/databases/$(database)/documents/stories/$(storyId)).data.get('isAdult', false) == true;
    }
    function storyPublic(storyId) {
      return storyPublished(storyId) && (signedIn() || !storyAdult(storyId));
    }

    // ── Historias ─────────────────────────────────────────────────────────────
    match /stories/{storyId} {
      // La ficha de una historia publicada (título, portada, sinopsis) es pública: la ve
      // cualquiera, también sin cuenta. Los borradores, solo su autor y moderación.
      // resource == null: leer una historia que NO existe devuelve "no existe" en vez de
      // "sin permiso"; así la app detecta las historias borradas. No expone datos.
      allow read: if (resource != null && resource.data.published == true)
                  || (signedIn()
                      && (resource == null || resource.data.uid == request.auth.uid || can('deleteStories')));
      // Una historia nace sin "me gusta"
      allow create: if signedIn() && request.auth.uid == request.resource.data.uid
                    && request.resource.data.get('likeCount', 0) == 0
                    && !isSuspended();

      // Contador de "me gusta": cualquier lector puede cambiarlo, pero solo ese campo,
      // de uno en uno y en la misma operación en la que crea (+1) o borra (-1) su
      // propio "me gusta". Así no se puede inflar ni vaciar.
      function likeCountChange() {
        let likePath = /databases/$(database)/documents/stories/$(storyId)/likes/$(request.auth.uid);
        let before = resource.data.get('likeCount', 0);
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount'])
          && (
            (request.resource.data.likeCount == before + 1 && !exists(likePath) && existsAfter(likePath))
            || (request.resource.data.likeCount == before - 1 && exists(likePath) && !existsAfter(likePath))
          );
      }

      // Lo mismo para los "me gusta" por capítulo: el total de la historia sube o baja de
      // uno en uno, acompañado del me gusta del capítulo indicado en lastLikedChapter.
      function chapterLikeCountChange() {
        let chapterId = request.resource.data.get('lastLikedChapter', '');
        let likePath = /databases/$(database)/documents/stories/$(storyId)/chapters/$(chapterId)/likes/$(request.auth.uid);
        let before = resource.data.get('likeCount', 0);
        return chapterId is string && chapterId != ''
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount', 'lastLikedChapter'])
          && (
            (request.resource.data.likeCount == before + 1 && !exists(likePath) && existsAfter(likePath))
            || (request.resource.data.likeCount == before - 1 && exists(likePath) && !existsAfter(likePath))
          );
      }

      // El autor edita su historia, pero no puede cambiar su dueño ni tocar el contador
      allow update: if signedIn() && (
        (resource.data.uid == request.auth.uid
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.get('likeCount', 0) == resource.data.get('likeCount', 0)
          && !isSuspended())
        || likeCountChange()
        || chapterLikeCountChange()
      );
      // Borrar: el autor, o moderación
      allow delete: if signedIn() && (resource.data.uid == request.auth.uid || can('deleteStories'));

      // ── Capítulos ───────────────────────────────────────────────────────────
      match /chapters/{chapterId} {
        function chapterPath() { return /databases/$(database)/documents/stories/$(storyId)/chapters/$(chapterId); }
        function storyPath() { return /databases/$(database)/documents/stories/$(storyId); }
        // Contador de "me gusta" del capítulo: cualquier lector, pero solo ese campo, de
        // uno en uno y junto con su propio me gusta
        function chapterLikeChange() {
          let likePath = /databases/$(database)/documents/stories/$(storyId)/chapters/$(chapterId)/likes/$(request.auth.uid);
          let before = resource.data.get('likeCount', 0);
          return signedIn()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount'])
            && (
              (request.resource.data.likeCount == before + 1 && !exists(likePath) && existsAfter(likePath))
              || (request.resource.data.likeCount == before - 1 && exists(likePath) && !existsAfter(likePath))
            );
        }

        allow read: if storyPublic(storyId) || ownsStory(storyId) || can('deleteStories');
        // Un capítulo nace sin "me gusta", y el autor no puede tocar su contador
        allow create: if ownsStory(storyId) && !isSuspended()
                      && request.resource.data.get('likeCount', 0) == 0;
        allow update: if (ownsStory(storyId) && !isSuspended()
                          && request.resource.data.get('likeCount', 0) == resource.data.get('likeCount', 0))
                      || chapterLikeChange();
        allow delete: if ownsStory(storyId) || can('deleteStories');

        // ── Me gusta del capítulo ───────────────────────────────────────────
        // Un documento por lector (id = su uid). Crear o borrar el propio exige mover a
        // la vez el contador del capítulo y el total de la historia.
        match /likes/{userId} {
          allow read: if signedIn();
          allow create: if isUser(userId) && storyPublished(storyId)
                        && getAfter(chapterPath()).data.likeCount == get(chapterPath()).data.get('likeCount', 0) + 1
                        && getAfter(storyPath()).data.likeCount == get(storyPath()).data.get('likeCount', 0) + 1;
          allow delete: if (isUser(userId)
                            && getAfter(chapterPath()).data.likeCount == get(chapterPath()).data.get('likeCount', 0) - 1
                            && getAfter(storyPath()).data.likeCount == get(storyPath()).data.get('likeCount', 0) - 1)
                        || ownsStory(storyId) || can('deleteStories');
        }

        // ── Páginas ─────────────────────────────────────────────────────────
        match /pages/{pageId} {
          allow read: if storyPublic(storyId) || ownsStory(storyId) || can('deleteStories');
          allow create, update: if ownsStory(storyId) && !isSuspended();
          allow delete: if ownsStory(storyId) || can('deleteStories');
        }
      }

      // ── Me gusta ────────────────────────────────────────────────────────────
      // Un documento por lector (id = su uid). Crear o borrar el propio exige mover el
      // contador de la historia en la misma operación (ver likeCountChange). El autor y
      // moderación pueden borrarlos al eliminar la historia.
      match /likes/{userId} {
        function storyPath() { return /databases/$(database)/documents/stories/$(storyId); }
        allow read: if signedIn();
        allow create: if isUser(userId) && storyPublished(storyId)
                      && getAfter(storyPath()).data.likeCount == get(storyPath()).data.get('likeCount', 0) + 1;
        allow delete: if (isUser(userId)
                          && getAfter(storyPath()).data.likeCount == get(storyPath()).data.get('likeCount', 0) - 1)
                      || ownsStory(storyId) || can('deleteStories');
      }

      // ── Estadísticas: lecturas y guardados ──────────────────────────────────
      // Solo el autor y moderación pueden leerlas: en la app se muestran como recuento,
      // nunca quién es cada uno.
      //
      // Ficha de lector (id = su uid): { views, lastAt }. lastAt es siempre la hora del
      // servidor, así no se puede falsear con el reloj del móvil.
      match /readers/{userId} {
        allow read: if isUser(userId) || ownsStory(storyId) || can('deleteStories');
        // Primera lectura: cuenta 1 (también para el autor en su propia historia)
        allow create: if isUser(userId)
                      && (storyPublished(storyId) || ownsStory(storyId))
                      && request.resource.data.views == 1
                      && request.resource.data.lastAt == request.time;
        allow update: if isUser(userId)
                      && request.resource.data.lastAt == request.time
                      && (
                        // Salir de la lectura: solo se apunta la hora
                        request.resource.data.views == resource.data.views
                        // Lectura nueva: +1, si han pasado 10 min desde que salió.
                        // El autor no suma más lecturas a su propia historia.
                        || (!ownsStory(storyId)
                            && request.resource.data.views == resource.data.views + 1
                            && request.time > resource.data.lastAt + duration.value(10, 'm'))
                        // Fichas antiguas sin contador: se inician en 1
                        || (!('views' in resource.data) && request.resource.data.views == 1)
                      );
        allow delete: if isUser(userId) || ownsStory(storyId) || can('deleteStories');
      }
      match /saves/{userId} {
        allow read: if isUser(userId) || ownsStory(storyId) || can('deleteStories');
        allow create, update: if isUser(userId) && storyPublished(storyId);
        allow delete: if isUser(userId) || ownsStory(storyId) || can('deleteStories');
      }

      // ── Comentarios ─────────────────────────────────────────────────────────
      // Cualquier lector comenta con su propio uid; no se editan. Los borra quien lo
      // escribió, el autor de la novela o moderación.
      match /comments/{commentId} {
        allow read: if storyPublic(storyId) || ownsStory(storyId) || can('deleteStories');
        allow create: if signedIn()
                      && request.resource.data.uid == request.auth.uid
                      && request.resource.data.text is string
                      && request.resource.data.text.size() > 0
                      && request.resource.data.text.size() <= 500
                      && (storyPublished(storyId) || ownsStory(storyId))
                      && !isSuspended();
        allow delete: if signedIn()
                      && (resource.data.uid == request.auth.uid || ownsStory(storyId) || can('deleteStories'));
      }
    }

    // ── Perfiles públicos ─────────────────────────────────────────────────────
    // Lo que los demás pueden ver de un usuario (nombre, avatar, bio, rol). Lo escribe
    // el propio usuario, pero el rol solo se acepta si coincide con el real de users/{uid}:
    // nadie puede mostrarse como dueño o administrador sin serlo.
    match /profiles/{userId} {
      // Público: es lo que se muestra de un autor junto a sus historias
      allow read: if true;
      allow create, update: if isUser(userId) && request.resource.data.get('role', '') == myRole();
      allow delete: if isUser(userId) || isOwner();

      // Seguidores (id = uid de quien sigue): cada uno se apunta y se borra a sí mismo
      match /followers/{followerId} {
        allow read: if true;
        allow create: if isUser(followerId) && followerId != userId;
        // También el dueño del perfil, al eliminar su cuenta
        allow delete: if isUser(followerId) || isUser(userId) || isOwner();
      }
    }

    // ── Usuarios ──────────────────────────────────────────────────────────────
    match /users/{userId} {
      // Solo se tocan los campos de rol, y el resultado es "admin" o "sin rol"
      // (desde la app nunca se puede crear otro dueño)
      function onlyStaffFields() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'permissions'])
          && request.resource.data.get('role', '') in ['', 'admin'];
      }
      // El dueño gestiona a cualquiera que no sea dueño
      function staffChangeByOwner() {
        return isOwner() && resource.data.get('role', '') != 'owner' && onlyStaffFields();
      }
      // Un gestor ('manageAdmins') gestiona solo a quien está "por debajo": no es gestor
      // ni tiene permisos que el gestor no tenga. Y solo puede dejarle permisos que él
      // mismo tiene, nunca el de gestionar administradores.
      function staffChangeByManager() {
        return can('manageAdmins')
          && resource.data.get('role', '') != 'owner'
          && !('manageAdmins' in resource.data.get('permissions', []))
          && resource.data.get('permissions', []).hasOnly(me().get('permissions', []))
          && onlyStaffFields()
          && !('manageAdmins' in request.resource.data.get('permissions', []))
          && request.resource.data.get('permissions', []).hasOnly(me().get('permissions', []));
      }

      // Moderación suspende o rehabilita a usuarios que no son del equipo, y solo
      // puede tocar esos campos
      function suspensionChange() {
        return can('deleteStories')
          && resource.data.get('role', '') == ''
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['suspended', 'suspendedAt', 'suspendedBy']);
      }

      // Leen usuarios: quien gestiona administradores (buscar por correo, ver el equipo)
      // y moderación (saber si una cuenta está suspendida)
      allow read: if isUser(userId) || can('manageAdmins') || can('deleteStories');
      // Nadie puede darse rol o permisos a sí mismo: ni al crear su perfil ni al editarlo
      allow create: if isUser(userId)
                    && !('role' in request.resource.data)
                    && !('permissions' in request.resource.data);
      // La fecha de nacimiento se puede indicar una vez, pero no cambiar después
      // (decide el acceso al contenido +18)
      allow update: if (isUser(userId)
                        && request.resource.data.get('role', null) == resource.data.get('role', null)
                        && request.resource.data.get('permissions', null) == resource.data.get('permissions', null)
                        && (!('birthDate' in resource.data)
                            || request.resource.data.get('birthDate', null) == resource.data.birthDate)
                        // Nadie puede quitarse su propia suspensión
                        && request.resource.data.get('suspended', false) == resource.data.get('suspended', false))
                    || (signedIn() && request.auth.uid != userId
                        && (staffChangeByOwner() || staffChangeByManager() || suspensionChange()));
      // Borra su cuenta el propio usuario; el dueño de la app, para atender peticiones
      // de borrado (nunca la de otro miembro del equipo)
      allow delete: if isUser(userId) || (isOwner() && resource.data.get('role', '') == '');

      // Biblioteca, marcadores, progreso y notificaciones propias
      match /{collection}/{document=**} {
        allow read, write: if isUser(userId);
        // El dueño de la app, al borrar los datos de un usuario
        allow read, delete: if isOwner();
      }

      // Notificaciones que crea OTRO usuario:
      //  · me gusta, comentarios y nuevos seguidores, firmados con el uid de quien los envía
      //  · aviso al autor de que moderación eliminó su novela
      match /notifications/{notificationId} {
        allow create: if signedIn() && request.auth.uid != userId && (
          (request.resource.data.fromUid == request.auth.uid
            && request.resource.data.type in ['like', 'comment', 'follow']
            && request.resource.data.read == false
            && !isSuspended())
          || (request.resource.data.type == 'admin' && can('deleteStories'))
        );
      }
    }

    // ── Lápidas de historias borradas ─────────────────────────────────────────
    // Se crean justo antes de borrar (la historia aún existe). Los lectores las leen
    // para saber que se borró, su título y si fue el autor o un administrador.
    match /deletedStories/{storyId} {
      allow read: if signedIn();
      allow create: if (ownsStory(storyId) && request.resource.data.deletedBy == 'author')
                    || (can('deleteStories') && request.resource.data.deletedBy == 'admin');
      allow update: if false;
      // Moderación borra las que tienen más de 60 días: para entonces los lectores ya
      // han recibido el aviso. deletedAt es una fecha ISO ("2026-10-04T…").
      allow delete: if can('deleteStories')
                    && timestamp.date(
                         int(resource.data.deletedAt[0:4]),
                         int(resource.data.deletedAt[5:7]),
                         int(resource.data.deletedAt[8:10]))
                       < request.time - duration.value(60, 'd');
    }

    // ── Denuncias ─────────────────────────────────────────────────────────────
    // Cualquier usuario denuncia (una vez por contenido: el id es fijo y no se puede
    // sobrescribir). Solo moderación las lee y las cierra.
    match /reports/{reportId} {
      allow create: if signedIn()
                    && request.resource.data.reporterUid == request.auth.uid
                    && request.resource.data.type in ['story', 'comment'];
      allow read, delete: if can('deleteStories');
      allow update: if false;
    }

    // ── Noticias y avisos de administración ───────────────────────────────────
    match /announcements/{announcementId} {
      allow read: if signedIn();
      allow create, update, delete: if can('announcements');
    }
  }
}
