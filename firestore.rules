// Reglas de seguridad de Firestore para Immersa.
// Se publican en la consola de Firebase → Firestore Database → Reglas.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isUser(uid) { return signedIn() && request.auth.uid == uid; }

    // ── Roles y permisos (misma lógica que constants/permissions.ts) ──────────
    //   users/{uid}.role: 'owner' (dueño, todos los permisos) | 'admin'
    //   users/{uid}.permissions: lista de permisos de un admin
    //     'deleteStories' | 'announcements' | 'manageAdmins'
    // El dueño solo se asigna desde la consola de Firebase.
    function me() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    // Rol propio; '' si no tiene (o si la cuenta no tiene documento de usuario)
    function myRole() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? me().get('role', '')
        : '';
    }
    function isOwner() { return signedIn() && myRole() == 'owner'; }
    function can(permission) {
      return signedIn() && (
        myRole() == 'owner'
        || (myRole() == 'admin' && permission in me().get('permissions', []))
      );
    }

    function ownsStory(storyId) {
      return signedIn()
        && get(/databases/$(database)/documents/stories/$(storyId)).data.uid == request.auth.uid;
    }
    function storyPublished(storyId) {
      return get(/databases/$(database)/documents/stories/$(storyId)).data.published == true;
    }

    // ── Historias ─────────────────────────────────────────────────────────────
    match /stories/{storyId} {
      // resource == null: leer una historia que NO existe devuelve "no existe" en vez de
      // "sin permiso"; así la app detecta las historias borradas. No expone datos.
      allow read: if signedIn()
                  && (resource == null || resource.data.published == true
                      || resource.data.uid == request.auth.uid || can('deleteStories'));
      allow create: if signedIn() && request.auth.uid == request.resource.data.uid;
      // El autor no puede cambiar el dueño de la historia
      allow update: if signedIn() && resource.data.uid == request.auth.uid
                    && request.resource.data.uid == resource.data.uid;
      // Borrar: el autor, o moderación
      allow delete: if signedIn() && (resource.data.uid == request.auth.uid || can('deleteStories'));

      // ── Capítulos ───────────────────────────────────────────────────────────
      match /chapters/{chapterId} {
        allow read: if signedIn() && (storyPublished(storyId) || ownsStory(storyId) || can('deleteStories'));
        allow create, update: if ownsStory(storyId);
        allow delete: if ownsStory(storyId) || can('deleteStories');

        // ── Páginas ─────────────────────────────────────────────────────────
        match /pages/{pageId} {
          allow read: if signedIn() && (storyPublished(storyId) || ownsStory(storyId) || can('deleteStories'));
          allow create, update: if ownsStory(storyId);
          allow delete: if ownsStory(storyId) || can('deleteStories');
        }
      }

      // ── Comentarios ─────────────────────────────────────────────────────────
      // Cualquier lector comenta con su propio uid; no se editan. Los borra quien lo
      // escribió, el autor de la novela o moderación.
      match /comments/{commentId} {
        allow read: if signedIn() && (storyPublished(storyId) || ownsStory(storyId) || can('deleteStories'));
        allow create: if signedIn()
                      && request.resource.data.uid == request.auth.uid
                      && request.resource.data.text is string
                      && request.resource.data.text.size() > 0
                      && request.resource.data.text.size() <= 500
                      && (storyPublished(storyId) || ownsStory(storyId));
        allow delete: if signedIn()
                      && (resource.data.uid == request.auth.uid || ownsStory(storyId) || can('deleteStories'));
      }
    }

    // ── Perfiles públicos ─────────────────────────────────────────────────────
    // Lo que los demás pueden ver de un usuario (nombre, avatar, bio, rol). Lo escribe
    // el propio usuario, pero el rol solo se acepta si coincide con el real de users/{uid}:
    // nadie puede mostrarse como dueño o administrador sin serlo.
    match /profiles/{userId} {
      allow read: if signedIn();
      allow create, update: if isUser(userId) && request.resource.data.get('role', '') == myRole();
      allow delete: if isUser(userId);
    }

    // ── Usuarios ──────────────────────────────────────────────────────────────
    match /users/{userId} {
      // Solo se tocan los campos de rol, y el resultado es "admin" o "sin rol"
      // (desde la app nunca se puede crear otro dueño)
      function onlyStaffFields() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'permissions'])
          && request.resource.data.get('role', '') in ['', 'admin'];
      }
      // El dueño gestiona a cualquiera que no sea dueño
      function staffChangeByOwner() {
        return isOwner() && resource.data.get('role', '') != 'owner' && onlyStaffFields();
      }
      // Un gestor ('manageAdmins') gestiona solo a quien está "por debajo": no es gestor
      // ni tiene permisos que el gestor no tenga. Y solo puede dejarle permisos que él
      // mismo tiene, nunca el de gestionar administradores.
      function staffChangeByManager() {
        return can('manageAdmins')
          && resource.data.get('role', '') != 'owner'
          && !('manageAdmins' in resource.data.get('permissions', []))
          && resource.data.get('permissions', []).hasOnly(me().get('permissions', []))
          && onlyStaffFields()
          && !('manageAdmins' in request.resource.data.get('permissions', []))
          && request.resource.data.get('permissions', []).hasOnly(me().get('permissions', []));
      }

      // Quien gestiona administradores puede leer usuarios (buscar por correo, ver el equipo)
      allow read: if isUser(userId) || can('manageAdmins');
      // Nadie puede darse rol o permisos a sí mismo: ni al crear su perfil ni al editarlo
      allow create: if isUser(userId)
                    && !('role' in request.resource.data)
                    && !('permissions' in request.resource.data);
      allow update: if (isUser(userId)
                        && request.resource.data.get('role', null) == resource.data.get('role', null)
                        && request.resource.data.get('permissions', null) == resource.data.get('permissions', null))
                    || (signedIn() && request.auth.uid != userId
                        && (staffChangeByOwner() || staffChangeByManager()));
      allow delete: if isUser(userId);

      // Biblioteca, marcadores, progreso y notificaciones propias
      match /{collection}/{document=**} {
        allow read, write: if isUser(userId);
      }

      // Notificaciones que crea OTRO usuario:
      //  · likes y comentarios, firmados con el uid de quien los envía
      //  · aviso al autor de que moderación eliminó su novela
      match /notifications/{notificationId} {
        allow create: if signedIn() && request.auth.uid != userId && (
          (request.resource.data.fromUid == request.auth.uid
            && request.resource.data.type in ['like', 'comment']
            && request.resource.data.read == false)
          || (request.resource.data.type == 'admin' && can('deleteStories'))
        );
      }
    }

    // ── Lápidas de historias borradas ─────────────────────────────────────────
    // Se crean justo antes de borrar (la historia aún existe). Los lectores las leen
    // para saber que se borró, su título y si fue el autor o un administrador.
    match /deletedStories/{storyId} {
      allow read: if signedIn();
      allow create: if (ownsStory(storyId) && request.resource.data.deletedBy == 'author')
                    || (can('deleteStories') && request.resource.data.deletedBy == 'admin');
      allow update, delete: if false;
    }

    // ── Noticias y avisos de administración ───────────────────────────────────
    match /announcements/{announcementId} {
      allow read: if signedIn();
      allow create, update, delete: if can('announcements');
    }
  }
}
